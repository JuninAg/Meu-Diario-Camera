{
  "expo": {
    "name": "Meu Diário de Lugares",
    "slug": "meu-diario-de-lugares",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "meuappcameragps",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.meudiariodelugares.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-image-picker", { "cameraPermission": "Permitir que o Meu Diário de Lugares tire fotos dos seus registros.", "photosPermission": "Permitir que o Meu Diário de Lugares selecione fotos para os seus registros.", "microphonePermission": false }],
      ["expo-location", { "locationWhenInUsePermission": "Permitir que o Meu Diário de Lugares registre a localização dos lugares visitados." }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
